# ==========================================
# Frontend Environment Variables (.env.example)
# ==========================================

# 1. API & Backend Integration
# The base URL for the backend API endpoints.
# Example: http://localhost:8000/api OR https://api.production.com/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# The URL for real-time WebSocket connections (e.g. Socket.io)
# Example: http://localhost:8000 OR https://api.production.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# 2. Local Development Bypasses
# Set this to "true" to bypass Next.js Middleware route protection
# during local development when you don't have a valid auth token.
NEXT_PUBLIC_BYPASS_AUTH=true

# 3. Third-Party Integrations
# Google Maps API Key for location selection
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 4. App Information
NEXT_PUBLIC_APP_NAME="QuickHandy Admin"
NEXT_PUBLIC_SUPPORT_EMAIL="support@quickhandy.com"

# 5. Payment Gateway
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# ==========================================
# Production / Vercel Environment Variables
# ==========================================
# You MUST set these in your Vercel Dashboard (Project Settings -> Environment Variables)
# before deploying the application.

# 1. Database (Cloud PostgreSQL like Supabase, Neon, or Vercel Postgres)
# Example: postgresql://user:password@host.supabase.co:5432/postgres
DATABASE_URL="your_cloud_postgres_url_here"

# 2. NextAuth Secret (Required for production JWT encryption)
# You can generate one via: openssl rand -base64 32
NEXTAUTH_SECRET="your_generated_secret_here"

# 3. NextAuth URL (The live URL of your deployed application)
# Example: https://quickhandy.vercel.app
NEXTAUTH_URL="https://your-live-app.vercel.app"
